# PostgreSQL
DB_NAME=attendance
DB_USER=postgres
DB_PASS=your_password
DB_HOST=localhost
DB_PORT=5432

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Required by Compose and the backend. Generate a random secret; do not commit it.
QDRANT_API_KEY=

# Backend write API authentication
API_KEY=

# Deployment environment. Set to "production" to refuse booting with the
# placeholder pass-through liveness checker (real liveness required).
ENV=development
